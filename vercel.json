{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "rewrites": [
    {
      "source": "/api/forecasting/(.*)",
      "destination": "/api/forecasting"
    },
    {
      "source": "/api/weather/(.*)",
      "destination": "/api/weather"
    },
    {
      "source": "/api/disaster/(.*)",
      "destination": "/api/disaster"
    },
    {
      "source": "/api/spatial/(.*)",
      "destination": "/api/spatial"
    },
    {
      "source": "/api/hydrology/(.*)",
      "destination": "/api/hydrology"
    },
    {
      "source": "/((?!api/).*)",
      "destination": "/index.html"
    }
  ]
}
