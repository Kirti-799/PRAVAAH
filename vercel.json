{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "rewrites": [
    {
      "source": "/api/forecasting/model-status",
      "destination": "/api/forecasting/model_status"
    },
    {
      "source": "/api/disaster/risk-summary",
      "destination": "/api/disaster/risk_summary"
    },
    {
      "source": "/((?!api/).*)",
      "destination": "/index.html"
    }
  ]
}
