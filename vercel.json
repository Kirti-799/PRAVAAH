{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "cd frontend && npm install && npm run build",
  "outputDirectory": "frontend/dist",
  "functions": {
    "api/index.py": {
      "maxDuration": 15,
      "memory": 1024,
      "includeFiles": "{data/processed/**,ml/models/**}",
      "excludeFiles": "{**/*.tif,**/*.tiff,data/processed/rainfall/gridded/imd_gridded_daily_cell_rainfall_2018_2024.csv}"
    }
  },
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api/index.py"
    },
    {
      "source": "/api",
      "destination": "/api/index.py"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
