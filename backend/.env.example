# PRAVAAH Backend Environment Configuration
PROJECT_NAME="PRAVAAH API"
VERSION="0.1.0"

# Environment: "development" for local dev, "production" for cloud deployment
ENVIRONMENT="development"
API_V1_STR="/api"

# Comma-separated list of allowed frontend origins for CORS.
# Local development: "http://localhost:5173,http://127.0.0.1:5173"
# Production (Render): "https://<your-app>.vercel.app,http://localhost:5173"
# Never use wildcard "*" in production when credentials are enabled.
ALLOWED_ORIGINS="http://localhost:5173,http://127.0.0.1:5173"
