# PRAVAAH Global Workspace Environment Reference
# Individual services manage environment files in backend/.env and frontend/.env

# Backend Host & Port (Local)
BACKEND_HOST=127.0.0.1
BACKEND_PORT=8000

# Frontend Host & Port (Local)
FRONTEND_PORT=5173

# Local API Base URL (for development)
VITE_API_BASE_URL=http://localhost:8000

# Production Cloud References:
# - Frontend on Vercel: Set VITE_API_BASE_URL=https://<your-backend-app>.onrender.com
# - Backend on Render: Set ALLOWED_ORIGINS=https://<your-frontend-app>.vercel.app and ENVIRONMENT=production
